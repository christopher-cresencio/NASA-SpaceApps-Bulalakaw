{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BulalakawStationConfigSchema",
  "description": "Schema for the single top-of-code CONFIG object and scenarios.json mirror editable by Denise & Raindel",
  "type": "object",
  "required": [
    "missionTitle",
    "totalSols",
    "solDurationRealSeconds",
    "initialResources",
    "rates",
    "crew",
    "stations",
    "solSchedules",
    "scienceBadges",
    "nasaSources"
  ],
  "properties": {
    "missionTitle": { "type": "string" },
    "totalSols": { "type": "integer", "const": 3 },
    "solDurationRealSeconds": { "type": "number", "minimum": 60 },
    "initialResources": {
      "type": "object",
      "required": [
        "batteryPct",
        "oxygenCrewDays",
        "waterCrewDays",
        "foodCrewDays",
        "shieldingLevel",
        "missionDoseMsv",
        "missionDoseCapMsv",
        "moralePct"
      ],
      "properties": {
        "batteryPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "oxygenCrewDays": { "type": "number", "minimum": 0 },
        "waterCrewDays": { "type": "number", "minimum": 0 },
        "foodCrewDays": { "type": "number", "minimum": 0 },
        "shieldingLevel": { "type": "integer", "minimum": 0, "maximum": 4 },
        "missionDoseMsv": { "type": "number", "minimum": 0 },
        "missionDoseCapMsv": { "type": "number", "minimum": 1 },
        "moralePct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "rates": { "type": "object" },
    "crew": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "trait"],
        "properties": {
          "id": { "type": "string", "enum": ["liza", "andoy", "maya", "carlo"] },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "trait": { "type": "string" }
        }
      }
    },
    "stations": { "type": "array" },
    "solSchedules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "scienceBadges": { "type": "object" },
    "nasaSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "usedFor"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "usedFor": { "type": "string" }
        }
      }
    }
  }
}
